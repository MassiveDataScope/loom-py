{
  "bindings": {
    "('repo', AcmeRecord)": {
      "provider": "HttpTestHarness._build_module.<locals>._make_provider.<locals>._provider",
      "resolved": "InMemoryRepository",
      "scope": "APPLICATION"
    },
    "Environment": {
      "provider": "LoomContainer.register_instance.<locals>.<lambda>",
      "resolved": "Environment",
      "scope": "APPLICATION"
    },
    "RuntimeExecutor": {
      "provider": "bootstrap_app.<locals>.<lambda>",
      "resolved": "RuntimeExecutor",
      "scope": "APPLICATION"
    },
    "UseCaseFactory": {
      "provider": "install_use_cases.<locals>.<lambda>",
      "resolved": "UseCaseFactory",
      "scope": "APPLICATION"
    },
    "_NullConfig": {
      "provider": "LoomContainer.register_instance.<locals>.<lambda>",
      "resolved": "_NullConfig",
      "scope": "APPLICATION"
    }
  },
  "repo_bindings": {
    "AcmeRecord": "('repo', AcmeRecord)"
  }
}
